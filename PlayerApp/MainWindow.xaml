<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PlayerApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PlayerApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="PlayerApp">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Padding="12,10,10,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Width="56"
                Height="56"
                VerticalAlignment="Top"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <Grid>
                    <Image
                        x:Name="AlbumArtImage"
                        Stretch="Uniform"
                        Visibility="Collapsed" />
                    <FontIcon
                        x:Name="ArtPlaceholder"
                        Glyph="&#xE8D6;"
                        FontSize="22"
                        Foreground="{ThemeResource TextFillColorDisabledBrush}" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,2,0,4">
                <ScrollViewer
                    x:Name="TitleScroller"
                    Height="21"
                    HorizontalAlignment="Stretch"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollMode="Disabled">
                    <TextBlock
                        x:Name="TitleText"
                        FontSize="15"
                        FontWeight="SemiBold"
                        VerticalAlignment="Top"
                        Text="再生中のメディアがありません">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="TitleMarqueeTransform" X="0" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </ScrollViewer>
                <ScrollViewer
                    x:Name="ArtistScroller"
                    Height="17"
                    HorizontalAlignment="Stretch"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollMode="Disabled">
                    <TextBlock
                        x:Name="ArtistText"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Top"
                        Text="Spotifyなどのアプリで再生すると表示されます">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="ArtistMarqueeTransform" X="0" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </ScrollViewer>
            </StackPanel>

            <Border
                x:Name="DragZone"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent" />

            <StackPanel
                x:Name="CaptionButtonPanel"
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Orientation="Horizontal"
                Spacing="2"
                Margin="0,6,6,0">
                <Button
                    x:Name="LyricsButton"
                    Width="28"
                    Height="22"
                    Style="{StaticResource GhostButton}"
                    AutomationProperties.Name="歌詞を表示"
                    ToolTipService.ToolTip="歌詞を表示"
                    Click="OnLyricsClick">
                    <FontIcon FontSize="13" Glyph="&#xE8F2;" />
                </Button>
                <Button
                    x:Name="PinButton"
                    Width="28"
                    Height="22"
                    Style="{StaticResource GhostButton}"
                    AutomationProperties.Name="最前面に固定"
                    ToolTipService.ToolTip="最前面に固定"
                    Click="OnPinClick">
                    <FontIcon x:Name="PinIcon" FontSize="12" Glyph="&#xE718;" />
                </Button>
                <Button
                    x:Name="MinimizeButton"
                    Width="32"
                    Height="20"
                    Style="{StaticResource GhostButton}"
                    ToolTipService.ToolTip="最小化"
                    Click="OnMinimizeClick">
                    <FontIcon FontSize="9" Glyph="&#xE921;" />
                </Button>
                <Button
                    x:Name="CloseButton"
                    Width="32"
                    Height="20"
                    Style="{StaticResource GhostButton}"
                    ToolTipService.ToolTip="閉じる"
                    Click="OnCloseClick">
                    <FontIcon FontSize="9" Glyph="&#xE8BB;" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="PositionText"
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="--:--" />
            <Grid
                x:Name="TimelineBar"
                Grid.Column="1"
                Height="18"
                VerticalAlignment="Center"
                Background="Transparent"
                Opacity="0.4">
                <Border
                    x:Name="TimelineTrack"
                    Height="4"
                    Margin="5,0"
                    VerticalAlignment="Center"
                    CornerRadius="2"
                    Background="#33000000">
                    <Border
                        x:Name="TimelineFill"
                        Width="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        CornerRadius="2" />
                </Border>
                <Ellipse
                    x:Name="TimelineThumb"
                    Width="9"
                    Height="9"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="5,0,0,0">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="TimelineThumbTransform" X="0" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
            <TextBlock
                x:Name="DurationText"
                Grid.Column="2"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="--:--" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                x:Name="VolumePanel"
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center"
                HorizontalAlignment="Left">
                <FontIcon
                    x:Name="VolumeIcon"
                    FontSize="14"
                    Glyph="&#xE767;"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid
                    x:Name="VolumeBar"
                    Width="56"
                    Height="14"
                    VerticalAlignment="Center"
                    Background="Transparent">
                    <Border
                        x:Name="VolumeTrack"
                        Height="3"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        CornerRadius="2"
                        Background="#33000000">
                        <Border
                            x:Name="VolumeFill"
                            Width="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            CornerRadius="2" />
                    </Border>
                    <Ellipse
                        x:Name="VolumeThumb"
                        Width="7"
                        Height="7"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="4,0,0,0">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="VolumeThumbTransform" X="0" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
                <TextBlock
                    x:Name="VolumeText"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="--" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Button
                    x:Name="PreviousButton"
                    Width="38"
                    Height="34"
                    Style="{StaticResource GhostButton}"
                    Click="OnPreviousClick"
                    IsEnabled="False">
                    <FontIcon FontSize="17" Glyph="&#xE892;" />
                </Button>
                <Button
                    x:Name="PlayPauseButton"
                    Width="46"
                    Height="34"
                    Style="{StaticResource GhostButton}"
                    Click="OnPlayPauseClick"
                    IsEnabled="False">
                    <FontIcon x:Name="PlayPauseIcon" FontSize="19" Glyph="&#xE768;" />
                </Button>
                <Button
                    x:Name="NextButton"
                    Width="38"
                    Height="34"
                    Style="{StaticResource GhostButton}"
                    Click="OnNextClick"
                    IsEnabled="False">
                    <FontIcon FontSize="17" Glyph="&#xE893;" />
                </Button>
            </StackPanel>

            <Border
                x:Name="SessionSwitchArea"
                Grid.Column="2"
                Width="132"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Visibility="Collapsed">
                <Grid>
                    <ScrollViewer
                        x:Name="SessionSwitchScroller"
                        HorizontalAlignment="Stretch"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollMode="Disabled"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled">
                        <StackPanel
                            x:Name="SessionSwitchPanel"
                            Orientation="Horizontal"
                            Spacing="3" />
                    </ScrollViewer>
                    <Border
                        x:Name="SessionFadeLeft"
                        Width="12"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        IsHitTestVisible="False"
                        Visibility="Collapsed" />
                    <Border
                        x:Name="SessionFadeRight"
                        Width="12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        IsHitTestVisible="False"
                        Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>

        <Border
            x:Name="LyricsPanel"
            Grid.Row="3"
            Height="280"
            Margin="0,12,0,0"
            Padding="10,8"
            CornerRadius="8"
            BorderThickness="1"
            Visibility="Collapsed">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock x:Name="LyricsHeading" Text="歌詞" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock x:Name="LyricsMode" FontSize="11" HorizontalAlignment="Right" />
                </Grid>
                <Grid Grid.Row="1">
                    <ScrollViewer
                        x:Name="LyricsScroller"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        Visibility="Collapsed">
                        <StackPanel x:Name="LyricsLines" Spacing="4" Padding="0,30" />
                    </ScrollViewer>
                    <StackPanel x:Name="LyricsMessagePanel" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320">
                        <ProgressRing x:Name="LyricsLoading" Width="24" Height="24" IsActive="False" Visibility="Collapsed" />
                        <TextBlock x:Name="LyricsMessage" Text="再生中の曲がありません" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" />
                        <Button x:Name="LyricsRetry" Content="再取得" Style="{StaticResource GhostButton}" Padding="12,5"
                            HorizontalAlignment="Center" Visibility="Collapsed" Click="OnLyricsRetryClick" />
                    </StackPanel>
                </Grid>
                <HyperlinkButton x:Name="LyricsCredit" Grid.Row="2" Content="Lyrics · LRCLIB" NavigateUri="https://lrclib.net/"
                    HorizontalAlignment="Right" Padding="0" MinHeight="18" FontSize="10" />
            </Grid>
        </Border>
    </Grid>
</Window>
